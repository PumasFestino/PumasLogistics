<launch>
    <arg name="model_path" default="$(find yolo_lid)/models/best.pt" />

    <node name="yolo_category"
      pkg="yolo_lid"
      type="yolo_detect_node.py"
      output="screen">
    <param name="model_path" value="$(arg model_path)" />
    </node>

    <node name="centroid_to_3d" pkg="yolo_lid" type="centroid_to_3d.py" output="screen" />

</launch>
